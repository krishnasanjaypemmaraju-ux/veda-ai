# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Any stable Gemini 3.x Flash model works.
# Verified stable models (as of August 2026):
#   gemini-3.7-flash   (newest, high quality, thinking disabled automatically)
#   gemini-3.6-flash   (stable GA July 2026, DEFAULT)
#   gemini-3.5-flash   (stable GA May 2026)
#   gemini-3.5-flash-lite (fast, low cost)
#   gemini-3.1-flash-lite (fast, low cost)
GEMINI_MODEL=gemini-3.6-flash
